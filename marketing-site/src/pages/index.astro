---
const features=[
 ["Speech to text","Turn bounded audio requests into typed transcripts while keeping transport and model policy separate."],
 ["Text to speech","Generate audio through the same authenticated envelope and predictable error contract."],
 ["Translation","Move text between languages without hiding source/target semantics or silently filling absent fields."],
 ["Thin clients","Rust, TypeScript, and Dart handle transport only—no retries, caching, business logic, or surprise orchestration."],
 ["Typed failure","Transport failures and API error envelopes remain distinct, so callers can choose safe retry and UX behavior."],
 ["Cross-runtime parity","All three suites assert URL normalization, optional bearer auth, omitted optional fields, UTF-8 decoding, and typed errors."],
];
const samples=[
 {id:"rust",label:"Rust",file:"translate.rs",code:`use vxl_client::{
    types::TranslateRequest,
    VxlClient,
};

let client = VxlClient::new(
    "https://api.example.com",
    Some(api_key),
);
let result = client.translate(&TranslateRequest {
    text: "good morning".into(),
    source_lang: None,
    target_lang: "es".into(),
}).await?;
println!("{}", result.text);`,note:"Documented Rust client. Wire types are re-exported as `vxl_client::types`."},
 {id:"ts",label:"TypeScript",file:"translate.ts",code:`import { VxlClient, VxlApiError } from "@voxletra/client";

const client = new VxlClient({
  baseUrl: "https://api.example.com",
  apiKey,
});
try {
  const { text } = await client.translate({
    text: "good morning",
    target_lang: "es",
  });
  console.log(text);
} catch (error) {
  if (error instanceof VxlApiError) {
    console.error(error.code, error.message);
  }
}`,note:"Zero-runtime-dependency TypeScript client with injectable fetch for deterministic tests."},
 {id:"dart",label:"Dart / Flutter",file:"translate.dart",code:`import 'package:vxl_client/vxl_client.dart';

final client = VxlClient(
  baseUrl: 'https://api.example.com',
  apiKey: apiKey,
);
try {
  final result = await client.translate(
    const TranslateRequest(
      text: 'good morning',
      targetLang: 'es',
    ),
  );
  print(result.text);
} on VxlApiException catch (error) {
  print('${error.code}: ${error.message}');
} finally {
  client.close();
}`,note:"Dart decodes UTF-8 explicitly and supports an injected package:http client for testing."},
];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="Speech-to-text, text-to-speech, and translation with thin, consistent client SDKs."><meta name="theme-color" content="#081626"><title>Voxletra — voice becomes useful</title></head><body>
<header><a class="brand" href="/"><b>VX</b><span>Voxletra</span></a><nav><a href="#platform">Platform</a><a href="#clients">Clients</a><a href="https://github.com/voxletra">GitHub ↗</a></nav></header><main>
<section class="hero"><div><p class="eyebrow">Voice and language APIs · Thin clients</p><h1>Voice becomes <em>usable knowledge.</em></h1><p class="lede">Voxletra gives applications one typed boundary for speech-to-text, text-to-speech, and translation—without burying retry policy, caching, or workflow decisions inside the SDK.</p><div class="actions"><a class="primary" href="https://github.com/voxletra">Explore the platform ↗</a><a href="#clients">Choose a client</a></div><ul><li>STT · TTS · translate</li><li>Rust · TypeScript · Dart</li><li>Typed error envelopes</li></ul></div><div class="visual"><span class="grid"></span><div class="wave" aria-hidden="true">▁▃▅▇▆▄▂▃▆█▅▂▁▃▇▆▄▂</div><div class="core"><small>LANGUAGE PIPELINE</small><strong>voice → meaning</strong><i>transport stays thin</i></div><div class="chip c1">INPUT<b>audio · text</b></div><div class="chip c2">STT<b>transcript</b></div><div class="chip c3">TRANSLATE<b>typed text</b></div><div class="chip c4">TTS<b>audio</b></div></div></section>
<section class="metrics"><div><b>3</b><span>official clients</span></div><div><b>3</b><span>core operations</span></div><div><b>25 MB</b><span>current audio cap</span></div><div><b>0</b><span>automatic retries</span></div></section>
<section id="platform" class="platform"><p class="eyebrow">Predictable at the edge</p><h2>Language services should not rewrite application policy.</h2><p class="intro">The clients build URLs, attach optional bearer tokens, encode requests, decode UTF-8 responses, and surface typed failures. The caller decides urgency, idempotence, backoff, caching, and user experience.</p><div class="features">{features.map(([t,b],i)=><article><small>{String(i+1).padStart(2,"0")}</small><h3>{t}</h3><p>{b}</p></article>)}</div></section>
<section id="clients" class="sdk" data-sdk><div><p class="eyebrow">Official client workbench</p><h2>Three SDKs. One behavior.</h2><p class="intro">The same transport contract is asserted in Rust, TypeScript, and Dart so language choice does not change authentication, omission, or error semantics.</p><a class="source" href="https://github.com/voxletra">Browse Voxletra ↗</a></div><div class="workbench"><div class="toolbar"><label><span>Language</span><select aria-label="Select client language" data-language>{samples.map((s,i)=><option value={s.id} selected={i===0}>{s.label}</option>)}</select></label><code data-file>{samples[0]?.file ?? "translate.rs"}</code><button data-copy type="button">Copy</button></div>{samples.map((s,i)=><article data-sample={s.id} data-name={s.file} hidden={i!==0}><pre tabindex="0"><code>{s.code}</code></pre><p>{s.note}</p></article>)}</div></section>
<section class="closing"><p class="eyebrow">Say it once. Use it everywhere.</p><h2>Build voice and translation experiences without transport surprises.</h2><a href="https://github.com/voxletra">Open the organization ↗</a></section></main><footer><span>© 2026 Voxletra</span><a href="https://github.com/voxletra">Platform source</a></footer>
<script is:inline>document.querySelectorAll('[data-sdk]').forEach((r)=>{const s=r.querySelector('[data-language]'),f=r.querySelector('[data-file]'),c=r.querySelector('[data-copy]'),p=[...r.querySelectorAll('[data-sample]')];const show=(id)=>p.forEach((x)=>{const a=x.dataset.sample===id;x.hidden=!a;if(a)f.textContent=x.dataset.name||''});s?.addEventListener('change',(e)=>show(e.target.value));c?.addEventListener('click',async()=>{const a=p.find((x)=>!x.hidden),t=a?.querySelector('code')?.textContent||'';try{await navigator.clipboard.writeText(t);c.textContent='Copied'}catch{a?.querySelector('pre')?.focus();c.textContent='Select code'}setTimeout(()=>c.textContent='Copy',1200)})});</script>
<style>:root{--accent:#2563eb;--hot:#06b6d4;--ink:#081626;--muted:#607086;--paper:#f5f9ff}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:linear-gradient(180deg,#eff6ff,var(--paper) 36rem);color:var(--ink);font:16px/1.6 Inter,system-ui,sans-serif}a{color:inherit}header,main,footer{width:min(1180px,calc(100% - 2rem));margin:auto}header{display:flex;justify-content:space-between;align-items:center;padding:1.1rem 0}.brand{display:flex;gap:.6rem;align-items:center;font-weight:900;text-decoration:none}.brand b{display:grid;width:2.35rem;aspect-ratio:1;place-items:center;border-radius:.75rem;background:var(--ink);color:white;font-size:.7rem}nav{display:flex;gap:1.2rem;font-size:.85rem;font-weight:800}nav a{text-decoration:none}.hero{display:grid;grid-template-columns:1.04fr .96fr;gap:clamp(2rem,7vw,7rem);align-items:center;min-height:720px;padding:5rem 0}.eyebrow{margin:0;color:var(--accent);font:800 .7rem/1 ui-monospace,monospace;letter-spacing:.17em;text-transform:uppercase}h1{max-width:12ch;margin:.8rem 0 1.25rem;font-size:clamp(3.5rem,8vw,7rem);line-height:.86;letter-spacing:-.075em}h1 em{background:linear-gradient(120deg,var(--accent),var(--hot));background-clip:text;color:transparent;font-style:normal}.lede,.intro{max-width:47rem;color:var(--muted);font-size:1.08rem}.actions{display:flex;gap:.7rem;flex-wrap:wrap;margin:2rem 0}.actions a,.closing a{padding:.75rem 1rem;border:1px solid #0f172a1b;border-radius:.75rem;font-weight:850;text-decoration:none}.primary{background:var(--ink);color:white}.hero ul{display:flex;gap:1rem;flex-wrap:wrap;margin:0;padding:0;color:var(--muted);font-size:.8rem;list-style:none}.hero li:before{content:'◆';margin-right:.4rem;color:var(--accent)}.visual{position:relative;min-height:32rem;overflow:hidden;border-radius:2rem;background:radial-gradient(circle at 50% 48%,#2563eb48,transparent 40%),linear-gradient(145deg,#071522,#102d49);box-shadow:0 35px 90px #1e3a8a42}.grid{position:absolute;inset:0;background-image:linear-gradient(#ffffff0c 1px,transparent 1px),linear-gradient(90deg,#ffffff0c 1px,transparent 1px);background-size:2.4rem 2.4rem}.wave{position:absolute;inset:31% 6% auto;color:#38bdf8;font:800 clamp(1.1rem,3vw,2rem)/1 ui-monospace,monospace;letter-spacing:.1em;text-align:center;opacity:.72}.core,.chip{position:absolute;z-index:2;display:grid;padding:.9rem;border:1px solid #ffffff25;border-radius:1rem;background:#0b2137df;color:#7dd3fc;backdrop-filter:blur(12px);font:700 .64rem/1.5 ui-monospace,monospace}.core{top:54%;left:50%;width:14rem;padding:1.2rem;transform:translate(-50%,-50%)}.core strong,.chip b{color:white}.core strong{font-size:1.28rem}.core i{font-style:normal}.c1{top:8%;left:7%}.c2{top:8%;right:7%}.c3{bottom:9%;left:7%}.c4{right:7%;bottom:9%}.metrics{display:grid;grid-template-columns:repeat(4,1fr);overflow:hidden;border:1px solid #1e3a8a18;border-radius:1.15rem;background:#ffffffc9}.metrics div{display:grid;padding:1.2rem}.metrics div+div{border-left:1px solid #1e3a8a18}.metrics b{font-size:1.3rem}.metrics span{color:var(--muted);font-size:.76rem}.platform{padding:8rem 0}.platform h2,.sdk h2,.closing h2{max-width:15ch;margin:.55rem 0 1rem;font-size:clamp(2.6rem,6vw,5rem);line-height:.94;letter-spacing:-.06em}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:3rem}.features article{min-height:14rem;padding:1.3rem;border:1px solid #1e3a8a14;border-radius:1.1rem;background:#ffffffc5}.features small{color:var(--accent);font:800 .68rem/1 ui-monospace,monospace}.features h3{margin:2.1rem 0 .55rem}.features p{color:var(--muted)}.sdk{display:grid;grid-template-columns:minmax(0,.78fr) minmax(31rem,1.22fr);gap:clamp(2rem,7vw,6rem);align-items:center;margin:3rem 0 9rem}.source{display:inline-block;margin-top:1rem;color:var(--accent);font-weight:850;text-decoration:none}.workbench{overflow:hidden;border:1px solid #ffffff24;border-radius:1.25rem;background:#071522;color:#dbeafe;box-shadow:0 32px 90px #1e3a8a40}.toolbar{display:flex;gap:.8rem;align-items:end;padding:.85rem 1rem;border-bottom:1px solid #ffffff18;background:#0d2238}.toolbar label{display:grid;gap:.25rem}.toolbar label span{color:#7dd3fc;font:700 .6rem/1 ui-monospace,monospace;letter-spacing:.13em;text-transform:uppercase}.toolbar select,.toolbar button{border:1px solid #ffffff28;border-radius:.58rem;background:#12304d;color:white;padding:.5rem .65rem;font:inherit}.toolbar button{margin-left:auto;cursor:pointer}.toolbar>code{align-self:center;color:#7dd3fc;font-size:.75rem}.workbench pre{overflow:auto;min-height:23rem;max-height:31rem;margin:0;padding:1.2rem;font:500 .82rem/1.7 ui-monospace,monospace;white-space:pre}.workbench article>p{margin:0;padding:.8rem 1.2rem 1rem;border-top:1px solid #ffffff15;color:#7dd3fc;font-size:.78rem}.closing{margin-bottom:2rem;padding:clamp(2rem,7vw,6rem);border-radius:1.8rem;background:linear-gradient(125deg,var(--accent),var(--hot));color:white}.closing .eyebrow{color:#ffffffc7}.closing a{display:inline-block;margin-top:1rem;background:white;color:var(--ink)}footer{display:flex;gap:1rem;padding:1.5rem 0 3rem;color:var(--muted);font-size:.78rem}footer span{margin-right:auto}footer a{text-decoration:none}@media(max-width:900px){.hero,.sdk{grid-template-columns:1fr}.features{grid-template-columns:1fr 1fr}}@media(max-width:650px){nav a:not(:last-child){display:none}.visual{min-height:26rem}.metrics{grid-template-columns:1fr 1fr}.features{grid-template-columns:1fr}.toolbar{align-items:stretch;flex-wrap:wrap}.toolbar>code{width:100%;order:3}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}</style></body></html>
